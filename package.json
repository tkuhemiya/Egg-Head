{
  "name": "egghead",
  "version": "0.2.0",
  "description": "Incident-call agent that uses Strands Decider 2B to decide when to speak, and Amazon Bedrock only when it does",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-decider.ts",
    "replay": "tsx scripts/replay-research.ts",
    "demo": "tsx --env-file-if-exists=.env demo/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "3.1155.0",
    "@aws-sdk/client-transcribe-streaming": "3.1155.0",
    "@mariozechner/pi-coding-agent": "^0.27.9",
    "@strands-agents/sdk": "1.22.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "effect": "4.0.5",
    "jmespath": "0.16.0",
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "24.19.2",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
