#!/usr/bin/env node
/**
 * Stand-in AWS CLI for the demo. The coding agent runs ordinary `aws ...` commands and gets
 * answers in the shapes the real CLI prints, made from data/aws.json (the scripted incident)
 * instead of a real account. Covers what an agent reaches for when checking an incident claim:
 * CloudWatch alarms and metrics, RDS, SQS, ECS deploys, load balancers, STS. Supports
 * --output json|text, --query (JMESPath) and the usual error codes for bad input.
 */
import { readFileSync } from "node:fs"
import { createRequire } from "node:module"

const require = createRequire(import.meta.url)
const jmespath = require("jmespath")
const world = JSON.parse(readFileSync(new URL("../../../data/aws.json", import.meta.url), "utf8"))
const NOW = Date.now()
const minutesAgo = (m) => new Date(NOW - m * 60_000)
const iso = (d) => d.toISOString().replace(/\.\d{3}Z$/, "+00:00")
const { account, region, cluster } = world

// ---------------------------------------------------------------------------
// Arguments
// ---------------------------------------------------------------------------

const argv = process.argv.slice(2)
const flags = {}
const positional = []
for (let i = 0; i < argv.length; i++) {
  const a = argv[i]
  if (a.startsWith("--")) {
    const [name, inline] = a.slice(2).split(/=(.*)/s)
    const values = inline !== undefined ? [inline] : []
    while (inline === undefined && i + 1 < argv.length && !argv[i + 1].startsWith("--")) values.push(argv[++i])
    flags[name] = values
  } else positional.push(a)
}
const flag = (name) => flags[name]?.[0]
const list = (name) => (flags[name] ?? []).flatMap((v) => v.split(/[\s]+/)).filter(Boolean)

const fail = (code, operation, message) => {
  process.stderr.write(`\nAn error occurred (${code}) when calling the ${operation} operation: ${message}\n`)
  process.exit(254)
}
const usage = (message) => {
  process.stderr.write(
    "usage: aws [options] <command> <subcommand> [<subcommand> ...] [parameters]\n" +
      "To see help text, you can run:\n\n  aws help\n  aws <command> help\n  aws <command> <subcommand> help\n\n" +
      `aws: error: ${message}\n`
  )
  process.exit(252)
}

const print = (data) => {
  const query = flag("query")
  const out = query ? jmespath.search(data, query) : data
  if (flag("output") === "text") {
    const rows = []
    const walk = (v) => {
      if (Array.isArray(v)) {
        if (v.every((x) => x === null || typeof x !== "object")) rows.push(v.join("\t"))
        else v.forEach(walk)
      } else if (v && typeof v === "object") {
        const scalars = Object.values(v).filter((x) => x === null || typeof x !== "object")
        if (scalars.length) rows.push(scalars.join("\t"))
        Object.values(v).filter((x) => x && typeof x === "object").forEach(walk)
      } else if (v !== null && v !== undefined) rows.push(String(v))
    }
    walk(out)
    process.stdout.write(rows.join("\n") + "\n")
  } else {
    process.stdout.write(JSON.stringify(out, null, 4) + "\n")
  }
}

// ---------------------------------------------------------------------------
// Metrics: a step (or ramp) from `before` to `now` at `sinceMin` minutes ago
// ---------------------------------------------------------------------------

const wobble = (t, scale) => scale * Math.sin(t / 97_000) * 0.6 + scale * Math.sin(t / 31_000) * 0.4
const stepAt = (s, t, ramp = false) => {
  const since = NOW - s.sinceMin * 60_000
  if (t < since || s.sinceMin === 0) return s.before
  if (!ramp) return s.now
  return s.before + (s.now - s.before) * Math.min(1, (t - since) / (s.sinceMin * 60_000) * 1.15)
}

const findResource = (dimensions) => {
  const values = dimensions.map((d) => String(d.Value ?? "").toLowerCase())
  const names = [...Object.keys(world.databases), ...Object.keys(world.services), ...Object.keys(world.queues)]
  return names.find((n) => values.some((v) => v === n || v.includes(n) || v.includes(world.services[n]?.loadBalancer ?? "\0")))
}

/** One value of a metric at time t, or undefined when the metric does not exist for it. */
const metricValue = (namespace, metric, resource, t, periodS, stat) => {
  const db = world.databases[resource], svc = world.services[resource], q = world.queues[resource]
  if (namespace === "AWS/RDS" && db) {
    if (metric === "CPUUtilization") return Math.min(100, stepAt(db.cpu, t) + wobble(t, 0.8))
    if (metric === "DatabaseConnections") return db.connections + Math.round(wobble(t, 6))
    if (metric === "FreeableMemory") return 6.1e9 + wobble(t, 1e8)
  }
  if (namespace === "AWS/ApplicationELB" && svc) {
    const requests = svc.requestsPerMin * periodS / 60
    const pct = Math.max(0, stepAt(svc.error5xxPct, t) + wobble(t, svc.error5xxPct.now * 0.04))
    if (metric === "RequestCount") return Math.round(requests + wobble(t, requests * 0.03))
    if (metric === "HTTPCode_Target_5XX_Count") return Math.round(requests * pct / 100)
    if (metric === "HTTPCode_Target_2XX_Count") return Math.round(requests * (100 - pct) / 100)
    if (metric === "TargetResponseTime") {
      const p99 = Math.max(0.01, stepAt(svc.p99s, t) + wobble(t, svc.p99s.now * 0.03))
      return stat === "p99" ? p99 : stat === "Maximum" ? p99 * 1.6 : p99 / 4.5
    }
  }
  if (namespace === "AWS/SQS" && q) {
    if (metric === "ApproximateNumberOfMessagesVisible") return Math.round(stepAt({ ...q, now: q.visible }, t, true))
    if (metric === "ApproximateNumberOfMessagesNotVisible") return q.inFlight
    if (metric === "ApproximateAgeOfOldestMessage") return t < NOW - q.sinceMin * 60_000 ? 4 : Math.round(q.oldestAgeS * (1 - (NOW - t) / (q.sinceMin * 60_000)))
  }
  return undefined
}

const UNITS = {
  CPUUtilization: "Percent", DatabaseConnections: "Count", FreeableMemory: "Bytes", RequestCount: "Count",
  HTTPCode_Target_5XX_Count: "Count", HTTPCode_Target_2XX_Count: "Count", TargetResponseTime: "Seconds",
  ApproximateNumberOfMessagesVisible: "Count", ApproximateNumberOfMessagesNotVisible: "Count", ApproximateAgeOfOldestMessage: "Seconds"
}
const round = (v, metric) => UNITS[metric] === "Count" ? Math.round(v) : Math.round(v * 1000) / 1000

const parseDimensions = (raw) => {
  if (!raw.length) return []
  const joined = raw.join(" ").trim()
  if (joined.startsWith("[") || joined.startsWith("{")) {
    const parsed = JSON.parse(joined)
    return Array.isArray(parsed) ? parsed : [parsed]
  }
  return raw.flatMap((r) => r.split(/\s+/)).filter(Boolean).map((pair) => {
    const m = /Name=([^,]+),Value=(.+)/.exec(pair)
    return m ? { Name: m[1], Value: m[2] } : { Name: pair, Value: "" }
  })
}

const parseTime = (s, fallback) => {
  if (!s) return fallback
  const rel = /^(?:now)?-?(\d+)\s*(m|min|minutes?|h|hours?)$/i.exec(s)
  if (rel) return NOW - Number(rel[1]) * (rel[2].startsWith("h") ? 3_600_000 : 60_000)
  const t = Date.parse(s)
  return Number.isNaN(t) ? fallback : t
}

const series = (namespace, metric, dimensions, startMs, endMs, periodS, stat) => {
  const resource = findResource(dimensions)
  if (!resource) return []
  const points = []
  const step = Math.max(60, periodS) * 1000
  const first = Math.ceil(Math.max(startMs, NOW - 3 * 3_600_000) / step) * step
  for (let t = first; t <= Math.min(endMs, NOW) && points.length < 1440; t += step) {
    const v = metricValue(namespace, metric, resource, t, periodS, stat)
    if (v === undefined) return []
    points.push([t, round(v, metric)])
  }
  return points
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

const alarmJson = (a) => ({
  AlarmName: a.name,
  AlarmArn: `arn:aws:cloudwatch:${region}:${account}:alarm:${a.name}`,
  AlarmDescription: `${a.metric} on ${a.dimension[1]}`,
  ActionsEnabled: true,
  AlarmActions: [`arn:aws:sns:${region}:${account}:oncall-page`],
  StateValue: a.state,
  StateReason: a.reason,
  StateUpdatedTimestamp: iso(minutesAgo(a.sinceMin)),
  MetricName: a.metric,
  Namespace: a.namespace,
  Statistic: a.metric === "HTTPCode_Target_5XX_Count" ? "Sum" : "Average",
  Dimensions: [{ Name: a.dimension[0], Value: a.dimension[1] }],
  Period: 60,
  EvaluationPeriods: 3,
  Threshold: a.threshold,
  ComparisonOperator: "GreaterThanThreshold"
})

const service = (name) => world.services[name]
const serviceJson = (name) => {
  const s = service(name)
  const [current, ...older] = s.deployments
  const deployment = (d, status) => ({
    id: `ecs-svc/${String(d.revision).padStart(4, "0")}${name.length}${d.minutesAgo % 97}`,
    status,
    taskDefinition: `arn:aws:ecs:${region}:${account}:task-definition/${name}:${d.revision}`,
    desiredCount: 6, runningCount: status === "PRIMARY" ? 6 : 0, pendingCount: 0,
    createdAt: iso(minutesAgo(d.minutesAgo)),
    updatedAt: iso(minutesAgo(Math.max(0, d.minutesAgo - 4))),
    launchType: "FARGATE",
    rolloutState: "COMPLETED",
    rolloutStateReason: `ECS deployment ecs-svc completed.`
  })
  return {
    serviceArn: `arn:aws:ecs:${region}:${account}:service/${cluster}/${name}`,
    serviceName: name,
    clusterArn: `arn:aws:ecs:${region}:${account}:cluster/${cluster}`,
    status: "ACTIVE", desiredCount: 6, runningCount: 6, pendingCount: 0, launchType: "FARGATE",
    taskDefinition: `arn:aws:ecs:${region}:${account}:task-definition/${name}:${current.revision}`,
    deployments: [deployment(current, "PRIMARY")],
    events: [current, ...older].slice(0, 3).map((d) => ({
      createdAt: iso(minutesAgo(Math.max(0, d.minutesAgo - 4))),
      message: `(service ${name}) has reached a steady state. Image ${name}:${d.version} (task definition ${name}:${d.revision}).`
    })),
    tags: [{ key: "version", value: current.version }]
  }
}

const queueUrl = (name) => `https://sqs.${region}.amazonaws.com/${account}/${name}`
const queueFrom = (url) => Object.keys(world.queues).find((q) => url && (url === q || url.endsWith(`/${q}`)))

const commands = {
  "sts get-caller-identity": () => print({ UserId: "AROA4EGGHEADONCALL:egg-head", Account: account, Arn: `arn:aws:sts::${account}:assumed-role/oncall-readonly/egg-head` }),

  "cloudwatch describe-alarms": () => {
    const names = list("alarm-names")
    const prefix = flag("alarm-name-prefix")
    const state = flag("state-value")
    const alarms = world.alarms.filter((a) =>
      (!names.length || names.includes(a.name)) && (!prefix || a.name.startsWith(prefix)) && (!state || a.state === state))
    print({ MetricAlarms: alarms.map(alarmJson), CompositeAlarms: [] })
  },

  "cloudwatch list-metrics": () => {
    const ns = flag("namespace"), name = flag("metric-name")
    const metrics = []
    for (const db of Object.keys(world.databases)) for (const m of ["CPUUtilization", "DatabaseConnections", "FreeableMemory"]) metrics.push({ Namespace: "AWS/RDS", MetricName: m, Dimensions: [{ Name: "DBInstanceIdentifier", Value: db }] })
    for (const [svc, s] of Object.entries(world.services)) for (const m of ["RequestCount", "HTTPCode_Target_5XX_Count", "HTTPCode_Target_2XX_Count", "TargetResponseTime"]) metrics.push({ Namespace: "AWS/ApplicationELB", MetricName: m, Dimensions: [{ Name: "LoadBalancer", Value: s.loadBalancer }] })
    for (const q of Object.keys(world.queues)) for (const m of ["ApproximateNumberOfMessagesVisible", "ApproximateNumberOfMessagesNotVisible", "ApproximateAgeOfOldestMessage"]) metrics.push({ Namespace: "AWS/SQS", MetricName: m, Dimensions: [{ Name: "QueueName", Value: q }] })
    print({ Metrics: metrics.filter((m) => (!ns || m.Namespace === ns) && (!name || m.MetricName === name)) })
  },

  "cloudwatch get-metric-statistics": () => {
    const namespace = flag("namespace"), metric = flag("metric-name")
    if (!namespace || !metric) usage("the following arguments are required: --namespace, --metric-name")
    const dims = parseDimensions(flags.dimensions ?? [])
    const end = parseTime(flag("end-time"), NOW)
    const start = parseTime(flag("start-time"), end - 3_600_000)
    const period = Number(flag("period") ?? 60)
    const stats = list("statistics"), ext = list("extended-statistics")
    if (!stats.length && !ext.length) fail("InvalidParameterCombination", "GetMetricStatistics", "Must specify either Statistics or ExtendedStatistics")
    const points = series(namespace, metric, dims, start, end, period, ext[0] ?? stats[0])
    const datapoints = points.map(([t, v]) => {
      const d = { Timestamp: iso(new Date(t)) }
      for (const s of stats) d[s] = s === "SampleCount" ? period / 60 : s === "Sum" ? v : s === "Maximum" ? round(v * 1.02, metric) : s === "Minimum" ? round(v * 0.97, metric) : v
      if (ext.length) d.ExtendedStatistics = Object.fromEntries(ext.map((e) => [e, round(metricValue(namespace, metric, findResource(dims), t, period, e) ?? v, metric)]))
      d.Unit = UNITS[metric] ?? "None"
      return d
    })
    print({ Label: metric, Datapoints: datapoints })
  },

  "cloudwatch get-metric-data": () => {
    let raw = (flags["metric-data-queries"] ?? []).join(" ")
    if (raw.startsWith("file://")) raw = readFileSync(raw.slice(7), "utf8")
    let queries
    try { queries = JSON.parse(raw) } catch { usage("argument --metric-data-queries: Invalid JSON") }
    const end = parseTime(flag("end-time"), NOW)
    const start = parseTime(flag("start-time"), end - 3_600_000)
    const results = queries.filter((q) => q.MetricStat).map((q) => {
      const m = q.MetricStat.Metric
      const points = series(m.Namespace, m.MetricName, m.Dimensions ?? [], start, end, q.MetricStat.Period ?? 60, q.MetricStat.Stat).reverse()
      return { Id: q.Id, Label: q.Label ?? m.MetricName, Timestamps: points.map(([t]) => iso(new Date(t))), Values: points.map(([, v]) => v), StatusCode: "Complete" }
    })
    print({ MetricDataResults: results, Messages: [] })
  },

  "rds describe-db-instances": () => {
    const id = flag("db-instance-identifier")
    if (id && !world.databases[id]) fail("DBInstanceNotFound", "DescribeDBInstances", `DBInstance ${id} not found.`)
    const dbs = Object.entries(world.databases).filter(([n]) => !id || n === id)
    print({
      DBInstances: dbs.map(([n, d]) => ({
        DBInstanceIdentifier: n, DBInstanceClass: d.class, Engine: d.engine, EngineVersion: "16.4",
        DBInstanceStatus: "available", MultiAZ: true, AvailabilityZone: `${region}a`,
        Endpoint: { Address: `${n}.c9x2ab3cd4ef.${region}.rds.amazonaws.com`, Port: 5432 },
        AllocatedStorage: 500, PerformanceInsightsEnabled: true
      }))
    })
  },

  "sqs list-queues": () => print({ QueueUrls: Object.keys(world.queues).map(queueUrl) }),
  "sqs get-queue-url": () => {
    const name = flag("queue-name")
    if (!world.queues[name]) fail("AWS.SimpleQueueService.NonExistentQueue", "GetQueueUrl", "The specified queue does not exist.")
    print({ QueueUrl: queueUrl(name) })
  },
  "sqs get-queue-attributes": () => {
    const name = queueFrom(flag("queue-url"))
    if (!name) fail("AWS.SimpleQueueService.NonExistentQueue", "GetQueueAttributes", "The specified queue does not exist.")
    const q = world.queues[name]
    const all = {
      QueueArn: `arn:aws:sqs:${region}:${account}:${name}`,
      ApproximateNumberOfMessages: String(q.visible),
      ApproximateNumberOfMessagesNotVisible: String(q.inFlight),
      ApproximateNumberOfMessagesDelayed: "0",
      CreatedTimestamp: String(Math.floor(NOW / 1000) - 86400 * 400),
      LastModifiedTimestamp: String(Math.floor(NOW / 1000) - 86400 * 30),
      VisibilityTimeout: "60",
      MessageRetentionPeriod: "345600",
      ReceiveMessageWaitTimeSeconds: "20"
    }
    const wanted = list("attribute-names")
    print({ Attributes: !wanted.length || wanted.includes("All") ? all : Object.fromEntries(wanted.filter((k) => k in all).map((k) => [k, all[k]])) })
  },

  "ecs list-clusters": () => print({ clusterArns: [`arn:aws:ecs:${region}:${account}:cluster/${cluster}`] }),
  "ecs list-services": () => print({ serviceArns: Object.keys(world.services).map((s) => `arn:aws:ecs:${region}:${account}:service/${cluster}/${s}`) }),
  "ecs describe-services": () => {
    const names = list("services").map((s) => s.split("/").pop())
    if (!names.length) usage("the following arguments are required: --services")
    print({
      services: names.filter(service).map(serviceJson),
      failures: names.filter((n) => !service(n)).map((n) => ({ arn: `arn:aws:ecs:${region}:${account}:service/${n}`, reason: "MISSING" }))
    })
  },

  "elbv2 describe-load-balancers": () => print({
    LoadBalancers: Object.entries(world.services).map(([n, s]) => ({
      LoadBalancerArn: `arn:aws:elasticloadbalancing:${region}:${account}:loadbalancer/${s.loadBalancer}`,
      DNSName: `${n}-alb-1234567890.${region}.elb.amazonaws.com`, LoadBalancerName: `${n}-alb`,
      Scheme: "internet-facing", State: { Code: "active" }, Type: "application"
    }))
  })
}

const [svc, op] = positional
if (flags.version) {
  process.stdout.write(`aws-cli/2.27.31 Python/3.13.4 Darwin/24.6.0 exe/arm64\n`)
  process.exit(0)
}
if (!svc || svc === "help") usage("the following arguments are required: command")
const services = [...new Set(Object.keys(commands).map((k) => k.split(" ")[0]))]
if (!services.includes(svc)) usage(`argument command: Invalid choice, valid choices are:\n\n${services.join(" | ")}`)
const ops = Object.keys(commands).filter((k) => k.startsWith(`${svc} `)).map((k) => k.split(" ")[1])
if (!op || op === "help") {
  process.stdout.write(`Available ${svc} commands:\n${ops.map((o) => `  o ${o}`).join("\n")}\n`)
  process.exit(0)
}
if (!ops.includes(op)) usage(`argument operation: Invalid choice, valid choices are:\n\n${ops.join(" | ")}`)
commands[`${svc} ${op}`]()
